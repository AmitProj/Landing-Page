<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050505">

<title>GrowthCraft — Digital Growth & Marketing Agency</title>

<meta name="description"
content="GrowthCraft helps ambitious businesses grow with Meta Ads, cold email outreach, creative design, GoHighLevel automation and high-converting landing pages.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

/* =========================================================
   ROOT
========================================================= */

:root{
    --black:#050505;
    --black2:#0b0b0b;
    --dark:#111111;
    --white:#ffffff;
    --offwhite:#f6f5f1;
    --gold:#c9a45c;
    --gold-light:#ead59c;
    --gold-dark:#8f6c2e;
    --gray:#8f8f8f;
    --line:rgba(0,0,0,.10);
    --dark-line:rgba(255,255,255,.10);

    --container:1240px;
    --radius:24px;
    --radius-sm:14px;

    --ease:cubic-bezier(.22,1,.36,1);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"DM Sans",sans-serif;
    color:var(--black);
    background:var(--offwhite);
    overflow-x:hidden;
}

body.lock{
    overflow:hidden;
}

img{
    width:100%;
    display:block;
}

a{
    text-decoration:none;
    color:inherit;
}

button{
    font-family:inherit;
}

.container{
    width:min(var(--container), calc(100% - 48px));
    margin:auto;
}

section{
    position:relative;
}

::selection{
    background:var(--gold);
    color:#000;
}

/* =========================================================
   CURSOR
========================================================= */

.cursor{
    position:fixed;
    width:10px;
    height:10px;
    border-radius:50%;
    background:var(--gold);
    pointer-events:none;
    z-index:99999;
    transform:translate(-50%,-50%);
    mix-blend-mode:difference;
}

.cursor-ring{
    position:fixed;
    width:36px;
    height:36px;
    border:1px solid rgba(201,164,92,.7);
    border-radius:50%;
    pointer-events:none;
    z-index:99998;
    transform:translate(-50%,-50%);
    transition:width .3s,height .3s;
}

@media(max-width:900px){
    .cursor,
    .cursor-ring{
        display:none;
    }
}

/* =========================================================
   UTILITIES
========================================================= */

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:9px;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:2.5px;
    font-weight:700;
    color:var(--gold-dark);
    margin-bottom:20px;
}

.eyebrow::before{
    content:"";
    width:24px;
    height:1px;
    background:currentColor;
}

.eyebrow.light{
    color:var(--gold-light);
}

.section-title{
    font-family:"Manrope",sans-serif;
    font-size:clamp(38px,5vw,72px);
    line-height:1.02;
    letter-spacing:-3px;
    font-weight:700;
}

.section-title span{
    color:var(--gold-dark);
}

.section-copy{
    color:#686868;
    line-height:1.8;
    max-width:600px;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    min-height:54px;
    padding:0 25px;
    border-radius:100px;
    font-size:13px;
    font-weight:700;
    transition:.4s var(--ease);
    cursor:pointer;
    border:1px solid transparent;
}

.btn svg{
    width:17px;
    transition:.4s var(--ease);
}

.btn:hover svg{
    transform:translateX(4px);
}

.btn-dark{
    color:#fff;
    background:#050505;
}

.btn-dark:hover{
    background:var(--gold);
    color:#050505;
    transform:translateY(-3px);
    box-shadow:0 15px 35px rgba(201,164,92,.22);
}

.btn-gold{
    color:#050505;
    background:var(--gold);
}

.btn-gold:hover{
    background:#fff;
    transform:translateY(-3px);
}

.btn-outline{
    border-color:rgba(0,0,0,.15);
    color:#050505;
}

.btn-outline:hover{
    background:#050505;
    color:#fff;
}

/* =========================================================
   HEADER
========================================================= */

.header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;
    padding:20px 0;
    transition:.4s var(--ease);
}

.header.scrolled{
    padding:11px 0;
}

.header-inner{
    height:66px;
    padding:0 10px 0 22px;
    border:1px solid rgba(255,255,255,.18);
    background:rgba(5,5,5,.75);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    border-radius:100px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    color:#fff;
}

.logo{
    font-family:"Manrope",sans-serif;
    font-weight:800;
    font-size:20px;
    letter-spacing:-.8px;
}

.logo span{
    color:var(--gold);
}

.nav{
    display:flex;
    gap:30px;
    align-items:center;
}

.nav a{
    font-size:12px;
    color:#bdbdbd;
    transition:.3s;
}

.nav a:hover{
    color:#fff;
}

.header .btn{
    min-height:44px;
    padding:0 20px;
    font-size:11px;
}

.menu-btn{
    width:44px;
    height:44px;
    border-radius:50%;
    background:#fff;
    border:0;
    display:none;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    gap:5px;
}

.menu-btn span{
    width:17px;
    height:1.5px;
    background:#000;
}

/* =========================================================
   HERO
========================================================= */

.hero{
    min-height:100vh;
    background:
        radial-gradient(circle at 75% 35%,rgba(201,164,92,.20),transparent 28%),
        radial-gradient(circle at 15% 80%,rgba(255,255,255,.08),transparent 25%),
        #050505;
    color:#fff;
    display:flex;
    align-items:center;
    overflow:hidden;
}

.hero-grid{
    position:absolute;
    inset:0;
    opacity:.11;
    background-image:
        linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.12) 1px,transparent 1px);
    background-size:70px 70px;
    mask-image:linear-gradient(to bottom,#000,transparent 85%);
}

.hero-orb{
    position:absolute;
    border-radius:50%;
    filter:blur(2px);
    pointer-events:none;
}

.orb-one{
    width:430px;
    height:430px;
    right:-120px;
    top:20%;
    border:1px solid rgba(201,164,92,.25);
    box-shadow:
        inset 0 0 80px rgba(201,164,92,.12),
        0 0 100px rgba(201,164,92,.08);
    animation:float 8s ease-in-out infinite;
}

.orb-two{
    width:180px;
    height:180px;
    right:24%;
    top:15%;
    background:radial-gradient(circle,var(--gold),transparent 65%);
    opacity:.15;
    filter:blur(35px);
    animation:float 6s ease-in-out infinite reverse;
}

@keyframes float{
    0%,100%{transform:translateY(0) rotate(0)}
    50%{transform:translateY(-25px) rotate(8deg)}
}

.hero-content{
    position:relative;
    z-index:2;
    padding-top:100px;
    padding-bottom:90px;
}

.hero-tag{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:8px 13px;
    border:1px solid rgba(201,164,92,.35);
    background:rgba(201,164,92,.07);
    border-radius:100px;
    color:#e7d29e;
    font-size:11px;
    letter-spacing:1.5px;
    text-transform:uppercase;
    margin-bottom:27px;
}

.hero-tag i{
    width:6px;
    height:6px;
    background:#b8ff78;
    border-radius:50%;
    box-shadow:0 0 10px #b8ff78;
}

.hero h1{
    font-family:"Manrope",sans-serif;
    font-size:clamp(55px,8vw,112px);
    line-height:.92;
    letter-spacing:-6px;
    max-width:1050px;
    font-weight:800;
}

.hero h1 .gold{
    color:var(--gold);
}

.hero h1 .outline{
    color:transparent;
    -webkit-text-stroke:1px rgba(255,255,255,.65);
}

.hero-bottom{
    margin-top:42px;
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:40px;
}

.hero-copy{
    color:#a5a5a5;
    max-width:470px;
    line-height:1.8;
    font-size:15px;
}

.hero-actions{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.hero .btn-outline{
    color:#fff;
    border-color:rgba(255,255,255,.2);
}

.hero .btn-outline:hover{
    background:#fff;
    color:#000;
}

.hero-scroll{
    position:absolute;
    right:30px;
    bottom:40px;
    writing-mode:vertical-rl;
    text-transform:uppercase;
    font-size:9px;
    letter-spacing:3px;
    color:#777;
}

.hero-scroll::after{
    content:"";
    display:block;
    height:50px;
    width:1px;
    background:linear-gradient(#777,transparent);
    margin:12px auto 0;
}

/* =========================================================
   MARQUEE
========================================================= */

.marquee{
    background:var(--gold);
    overflow:hidden;
    padding:18px 0;
    color:#050505;
}

.marquee-track{
    display:flex;
    width:max-content;
    animation:marquee 24s linear infinite;
}

.marquee-item{
    display:flex;
    align-items:center;
    gap:35px;
    padding-right:35px;
    white-space:nowrap;
    font-family:"Manrope",sans-serif;
    font-weight:800;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:1.4px;
}

.marquee-item::after{
    content:"✦";
    font-size:14px;
}

@keyframes marquee{
    to{transform:translateX(-50%)}
}

/* =========================================================
   INTRO
========================================================= */

.intro{
    padding:150px 0;
    background:#f6f5f1;
}

.intro-grid{
    display:grid;
    grid-template-columns:1fr 1.25fr;
    gap:80px;
    align-items:end;
}

.intro-number{
    font-size:12px;
    letter-spacing:2px;
    color:#999;
    margin-bottom:40px;
}

.intro-title{
    font-family:"Manrope";
    font-size:clamp(38px,5vw,70px);
    line-height:1.05;
    letter-spacing:-3px;
    max-width:750px;
}

.intro-title strong{
    font-weight:700;
}

.intro-side{
    display:grid;
    gap:30px;
}

.intro-side p{
    font-size:17px;
    line-height:1.8;
    color:#6d6d6d;
}

.signature{
    font-family:cursive;
    font-size:34px;
    color:#333;
}

/* =========================================================
   SERVICES
========================================================= */

.services{
    background:#fff;
    padding:130px 0;
}

.section-heading{
    display:flex;
    justify-content:space-between;
    gap:40px;
    margin-bottom:70px;
    align-items:flex-end;
}

.services-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    border-top:1px solid var(--line);
    border-left:1px solid var(--line);
}

.service-card{
    min-height:330px;
    padding:42px;
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
    position:relative;
    overflow:hidden;
    transition:.5s var(--ease);
}

.service-card::before{
    content:"";
    position:absolute;
    width:220px;
    height:220px;
    right:-100px;
    top:-100px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(201,164,92,.23),transparent 68%);
    transition:.6s;
}

.service-card:hover{
    background:#faf9f6;
}

.service-card:hover::before{
    transform:scale(1.7);
}

.service-number{
    color:#aaa;
    font-size:11px;
    letter-spacing:2px;
}

.service-icon{
    width:54px;
    height:54px;
    margin:55px 0 30px;
    border:1px solid rgba(0,0,0,.13);
    border-radius:16px;
    display:grid;
    place-items:center;
    transition:.4s;
}

.service-card:hover .service-icon{
    background:#050505;
    color:var(--gold);
    transform:rotate(-6deg);
}

.service-icon svg{
    width:23px;
}

.service-card h3{
    font-family:"Manrope";
    font-size:25px;
    letter-spacing:-1px;
    margin-bottom:12px;
}

.service-card p{
    color:#777;
    line-height:1.7;
    font-size:14px;
    max-width:450px;
}

.service-link{
    position:absolute;
    right:38px;
    bottom:38px;
    width:42px;
    height:42px;
    border-radius:50%;
    background:#050505;
    color:#fff;
    display:grid;
    place-items:center;
    transition:.4s;
}

.service-card:hover .service-link{
    background:var(--gold);
    color:#000;
    transform:rotate(-45deg);
}

/* =========================================================
   STATS
========================================================= */

.stats{
    background:#050505;
    color:#fff;
    padding:70px 0;
}

.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
}

.stat{
    text-align:center;
    padding:20px;
    border-right:1px solid rgba(255,255,255,.1);
}

.stat:last-child{
    border-right:0;
}

.stat strong{
    display:block;
    font-family:"Manrope";
    font-size:clamp(42px,5vw,65px);
    letter-spacing:-3px;
    color:var(--gold);
}

.stat span{
    color:#888;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:1.5px;
}

/* =========================================================
   FEATURE
========================================================= */

.feature{
    padding:150px 0;
    background:#f6f5f1;
}

.feature-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:100px;
    align-items:center;
}

.feature-visual{
    min-height:600px;
    background:#080808;
    border-radius:30px;
    position:relative;
    overflow:hidden;
    box-shadow:20px 30px 80px rgba(0,0,0,.14);
}

.feature-visual::before{
    content:"";
    position:absolute;
    width:450px;
    height:450px;
    border-radius:50%;
    border:1px solid rgba(201,164,92,.3);
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    box-shadow:
        0 0 80px rgba(201,164,92,.08),
        inset 0 0 80px rgba(201,164,92,.05);
}

.dashboard{
    position:absolute;
    width:75%;
    height:65%;
    left:12.5%;
    top:17%;
    border:1px solid rgba(255,255,255,.14);
    background:rgba(255,255,255,.05);
    backdrop-filter:blur(12px);
    border-radius:20px;
    padding:25px;
    transform:rotate(-4deg);
}

.dash-top{
    display:flex;
    justify-content:space-between;
    margin-bottom:25px;
}

.dash-title{
    color:#fff;
    font-size:12px;
}

.dash-status{
    color:#b8ff78;
    font-size:9px;
}

.chart{
    height:170px;
    display:flex;
    align-items:flex-end;
    gap:8px;
    border-bottom:1px solid rgba(255,255,255,.12);
}

.bar{
    flex:1;
    background:linear-gradient(to top,var(--gold-dark),var(--gold));
    border-radius:4px 4px 0 0;
    opacity:.9;
}

.dash-cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
    margin-top:20px;
}

.dash-card{
    height:50px;
    background:rgba(255,255,255,.06);
    border-radius:8px;
}

.feature-content .section-title{
    margin-bottom:25px;
}

.feature-list{
    margin-top:38px;
    display:grid;
    gap:17px;
}

.feature-list li{
    list-style:none;
    display:flex;
    gap:14px;
    color:#555;
    font-size:14px;
}

.feature-list li::before{
    content:"✓";
    width:22px;
    height:22px;
    border-radius:50%;
    background:#050505;
    color:var(--gold);
    display:grid;
    place-items:center;
    font-size:11px;
    flex:none;
}

/* =========================================================
   PORTFOLIO
========================================================= */

.portfolio{
    background:#050505;
    color:#fff;
    padding:140px 0;
    overflow:hidden;
}

.portfolio .section-title{
    color:#fff;
}

.portfolio .section-copy{
    color:#888;
}

.portfolio-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:40px;
    margin-bottom:60px;
}

.slider-controls{
    display:flex;
    gap:8px;
}

.slider-btn{
    width:48px;
    height:48px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.15);
    color:#fff;
    background:transparent;
    cursor:pointer;
    transition:.3s;
}

.slider-btn:hover{
    background:var(--gold);
    color:#000;
    border-color:var(--gold);
}

.portfolio-slider{
    display:flex;
    gap:24px;
    overflow-x:auto;
    scroll-behavior:smooth;
    scrollbar-width:none;
    padding-bottom:20px;
}

.portfolio-slider::-webkit-scrollbar{
    display:none;
}

.project{
    min-width:calc(50% - 12px);
    aspect-ratio:1.25;
    position:relative;
    border-radius:22px;
    overflow:hidden;
    background:#151515;
    cursor:pointer;
}

.project-bg{
    position:absolute;
    inset:0;
    transition:.7s var(--ease);
}

.project:hover .project-bg{
    transform:scale(1.06);
}

.project-1{
    background:
        radial-gradient(circle at 80% 20%,#d8b66f,transparent 22%),
        linear-gradient(135deg,#191919,#050505 60%);
}

.project-2{
    background:
        radial-gradient(circle at 25% 30%,#d1a44c,transparent 20%),
        linear-gradient(135deg,#262626,#050505);
}

.project-3{
    background:
        radial-gradient(circle at 70% 70%,#c9a45c,transparent 20%),
        linear-gradient(135deg,#101010,#282828);
}

.project-4{
    background:
        radial-gradient(circle at 30% 80%,#b98d3e,transparent 25%),
        linear-gradient(135deg,#252525,#050505);
}

.project-content{
    position:absolute;
    inset:auto 30px 30px;
    z-index:2;
}

.project-tag{
    font-size:9px;
    letter-spacing:2px;
    text-transform:uppercase;
    color:#dbc27e;
    margin-bottom:10px;
}

.project h3{
    font-family:"Manrope";
    font-size:27px;
}

.project-arrow{
    position:absolute;
    right:25px;
    top:25px;
    width:46px;
    height:46px;
    border-radius:50%;
    background:#fff;
    color:#000;
    display:grid;
    place-items:center;
    z-index:3;
    transition:.4s;
}

.project:hover .project-arrow{
    transform:rotate(45deg);
    background:var(--gold);
}

/* =========================================================
   CASE STUDIES
========================================================= */

.case-studies{
    padding:140px 0;
    background:#fff;
}

.case-list{
    margin-top:65px;
    border-top:1px solid var(--line);
}

.case{
    display:grid;
    grid-template-columns:120px 1fr 180px;
    gap:40px;
    align-items:center;
    padding:34px 0;
    border-bottom:1px solid var(--line);
    transition:.4s;
}

.case:hover{
    padding-left:15px;
}

.case-num{
    color:#999;
    font-size:12px;
}

.case h3{
    font-family:"Manrope";
    font-size:25px;
    margin-bottom:8px;
}

.case p{
    color:#777;
    font-size:13px;
}

.case-result{
    text-align:right;
}

.case-result strong{
    display:block;
    font-family:"Manrope";
    font-size:28px;
    color:var(--gold-dark);
}

.case-result span{
    font-size:10px;
    color:#888;
    text-transform:uppercase;
    letter-spacing:1px;
}

/* =========================================================
   PROCESS
========================================================= */

.process{
    padding:140px 0;
    background:#f6f5f1;
}

.process-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    margin-top:70px;
    border-top:1px solid var(--line);
    border-left:1px solid var(--line);
}

.process-card{
    padding:38px;
    min-height:280px;
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
}

.process-card .num{
    color:var(--gold-dark);
    font-family:"Manrope";
    font-size:13px;
}

.process-card h3{
    font-family:"Manrope";
    font-size:22px;
    margin:70px 0 14px;
}

.process-card p{
    color:#777;
    font-size:13px;
    line-height:1.7;
}

/* =========================================================
   WHY US
========================================================= */

.why{
    background:#050505;
    color:#fff;
    padding:140px 0;
}

.why-grid{
    display:grid;
    grid-template-columns:.8fr 1.2fr;
    gap:100px;
}

.why .section-copy{
    color:#888;
}

.why-items{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.why-card{
    border:1px solid rgba(255,255,255,.1);
    padding:30px;
    border-radius:18px;
    background:rgba(255,255,255,.025);
    transition:.4s;
}

.why-card:hover{
    transform:translateY(-6px);
    border-color:rgba(201,164,92,.4);
}

